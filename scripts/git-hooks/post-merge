#!/usr/bin/env bash
# git commit · merge · pull · rebase 후 → scripts/deploy.sh --range 로 변경 범위만큼 재시작/재빌드
# 설치: git config core.hooksPath scripts/git-hooks  (post-commit · post-rewrite · post-checkout 은 이 파일 symlink)
#
# - 라이브 작업 트리(메인 worktree, main 브랜치)에서만 동작 — 다른 worktree·detached(rebase 중) 는 무시
# - 05:50~08:00 KST · 실행 중 run 있으면 deploy.sh 가 경고만 하고 반영 안 함 (commit·merge 자체는 그대로)
# - AIRFLOW_DEPLOY_HOOK=warn 이면 자동 반영 대신 경고만
set -uo pipefail

hook=$(basename "$0")
[[ -n ${AIRFLOW_DEPLOY_RUNNING:-} ]] && exit 0    # deploy.sh 가 직접 반영 중

top=$(git rev-parse --show-toplevel)
[[ $(git rev-parse --git-dir) == "$(git rev-parse --git-common-dir)" ]] || exit 0
[[ $(git rev-parse --abbrev-ref HEAD) == main ]] || exit 0

case "$hook" in
  post-merge)  from=ORIG_HEAD ;;
  post-commit)
    # 라이브 트리 직접 커밋 (11-23 사고 경로). amend 포함 — 직전 HEAD(reflog) 기준
    from=$(git rev-parse -q --verify 'HEAD@{1}' || git rev-parse -q --verify 'HEAD~1' \
           || git hash-object -t tree /dev/null) ;;   # 첫 커밋 = 빈 트리 기준
  post-rewrite)
    [[ ${1:-} == rebase ]] || exit 0               # amend 는 post-commit 이 처리
    from=ORIG_HEAD ;;
  post-checkout)
    # 브랜치 전환만 경고 (라이브 bind mount 에서 금지) — 자동 반영하지 않음
    [[ ${3:-0} == 1 && $1 != "$2" ]] || exit 0
    files=$(git diff --name-only "$1" "$2" -- plugins Dockerfile requirements.txt docker-compose.yaml)
    printf '\033[1;31m[%s] 라이브 작업 트리에서 checkout 됨 — 브랜치 작업은 git worktree 에서\033[0m\n' "$hook"
    [[ -n $files ]] && printf '\033[1;31m  plugins/·이미지 입력 변경 있음 → 확인 후 scripts/deploy.sh --range %s %s\033[0m\n' \
      "$(git rev-parse --short "$1")" "$(git rev-parse --short "$2")"
    exit 0 ;;
  *) exit 0 ;;
esac

git rev-parse -q --verify "$from" >/dev/null || { echo "[$hook] $from 없음 — scripts/deploy.sh --check 로 확인"; exit 0; }

if [[ ${AIRFLOW_DEPLOY_HOOK:-auto} == warn ]]; then
  "$top/scripts/deploy.sh" --range "$from" HEAD --dry-run
  printf '\033[1;33m[%s] AIRFLOW_DEPLOY_HOOK=warn — 위 조치를 직접 실행: scripts/deploy.sh --range %s HEAD\033[0m\n' \
    "$hook" "$(git rev-parse --short "$from")"
  exit 0
fi

echo "[$hook] 변경 반영: scripts/deploy.sh --range $(git rev-parse --short "$from") HEAD"
"$top/scripts/deploy.sh" --range "$from" HEAD
rc=$?
if ((rc != 0)); then
  printf '\033[1;31m[%s] 반영 안 됨 (rc=%s) — 위 안내대로 나중에 scripts/deploy.sh --range %s HEAD\033[0m\n' \
    "$hook" "$rc" "$(git rev-parse --short "$from")"
fi
exit 0   # 훅 실패가 merge 결과를 바꾸지 않음
